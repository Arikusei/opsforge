# OpsForge — скопируйте в .env и заполните нужное.
# Демо работает без ключей (режим LLM=demo).

APP_ENV=demo
APP_SECRET=change-me-in-production
DATABASE_URL=sqlite:///./data/opsforge.db
KNOWLEDGE_DIR=./knowledge

# LLM: auto | openai | anthropic | demo
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# Агент: нативный tool calling (OpenAI tools / Anthropic tool_use).
# false — принудительно JSON-протокол, полезно для сравнения в eval.
AGENT_NATIVE_TOOLS=true
AGENT_MAX_ITERATIONS=6

# Наблюдаемость LLM: трейсы в таблицы agent_runs/llm_calls, метрики в /metrics.
TRACE_PERSIST=true
# Куда дублировать трейсы, например n8n-вебхук для алертов по стоимости и ошибкам.
TRACE_WEBHOOK_URL=
# Переопределение прайса, если модель не в встроенной таблице:
# "model:in_usd_per_1m,out_usd_per_1m;model2:..."
LLM_PRICE_OVERRIDES=

# Реальные интеграции (если пусто — используются mock-адаптеры)
CRM_BASE_URL=https://example.crm.ru
CRM_ACCESS_TOKEN=
TEAMCHAT_API_TOKEN=
TEAMCHAT_BOT_TOKEN=
PHONEPBX_API_KEY=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=opsforge
S3_SECRET_KEY=opsforge-secret
S3_BUCKET=opsforge-knowledge

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_USER=opsforge
N8N_BASIC_AUTH_PASSWORD=opsforge-n8n

WEBHOOK_SECRET=opsforge-webhook-dev
